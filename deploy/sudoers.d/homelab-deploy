# Install with: sudo install -m 440 -o root -g root sudoers.d/homelab-deploy /etc/sudoers.d/homelab-deploy
# Always validate with `visudo -cf` before installing — a syntax error in
# /etc/sudoers.d/ can lock out sudo entirely.
#
# This grants the single shared homelab-deploy account exactly one
# capability: running /opt/deploy/deploy-executor.sh as root, with any
# arguments, no password prompt — for every configured target, since they
# all share this one account. That's intentionally broad at the sudoers
# level: target/branch names are dynamic, and trying to enumerate every
# exact (target, branch, env-file) combination here would be unmaintainable
# as targets are added. The actual enforcement lives inside that script: it
# independently validates all three arguments against its own hardcoded
# per-target table before doing anything, and never passes them through a
# shell (no eval, no bash -c, no string-built commands) — so there's
# nothing for this wildcard to let through unsafely. This is the standard,
# documented sudoers pattern for a command that does its own argument
# validation.
#
# This account should NOT also be a member of the `docker` group — that
# would make this rule pointless, since group membership alone already
# grants full daemon control.

# SSH exec_command sessions (what the MCP server uses) have no controlling
# tty. Some distros default to `Defaults requiretty`, which would make sudo
# refuse to run at all in that context — this line overrides that for just
# this one account.
Defaults:homelab-deploy !requiretty

homelab-deploy ALL=(root) NOPASSWD: /opt/deploy/deploy-executor.sh *
